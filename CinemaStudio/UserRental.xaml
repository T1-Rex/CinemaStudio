<UserControl x:Class="CinemaStudio.UserRental"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CinemaStudio"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="StButtonMain" TargetType="Button">
            <Setter Property="Background" Value="#991F44A9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
   Background="{TemplateBinding Background}" 
   BorderThickness="2"
   BorderBrush="#FFFFFF"
   CornerRadius="10"
   Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="#FF1F44A9"/>
                    <Setter Property="BorderBrush" Value="#FF4E85EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF5646A8"/>
                    <Setter Property="BorderBrush" Value="#FF5646A8"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#401F44A9"/>
                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StTextListEmpty" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=DGRental, Path=Items.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StDGColumn" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Прокат" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="30"/>

            <Grid Grid.Row="1" MaxWidth="1150" MaxHeight="700">
                <Border Background="#99FFFFFF" BorderThickness="0,0,0,2" CornerRadius="20" Margin="20">
                    <Grid>
                        <DataGrid 
                       x:Name="DGRental"
                       AutoGenerateColumns="False"
                       HeadersVisibility="Column"
                       IsReadOnly="True"
                       Background="Transparent" 
                       BorderThickness="0"                                          
                       Margin="7"
                       SelectionChanged="DGRental_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Project.Name}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Проект" TextTrimming="CharacterEllipsis" ToolTip="Проект"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding DateExit, StringFormat={}{0:dd.MM.yyyy}}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Дата выхода" TextTrimming="CharacterEllipsis" ToolTip="Дата выхода"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding CountCinema}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Кол-во кинотеатров" TextTrimming="CharacterEllipsis" ToolTip="Кол-во кинотеатров"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Fees}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Сборы" TextTrimming="CharacterEllipsis" ToolTip="Сборы"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Rating}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Рейтинг" TextTrimming="CharacterEllipsis" ToolTip="Рейтинг"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Ничего не найдено" FontSize="22" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StTextListEmpty}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Border Background="#99FFFFFF" CornerRadius="20,0,0,20" Width="215">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Форма" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" Margin="3,3,0,0">
                        <!-- Project -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Проект" FontSize="14" FontWeight="Bold" Margin="27,3,0,0"/>

                            <Border Margin="5,0,0,0" Padding="3" Width="120" Height="32" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <ComboBox x:Name="CbFormProject" DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" Loaded="CbProject_Loaded"/>
                            </Border>
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Дата выхода" Width="55" FontSize="14" FontWeight="Bold" Margin="20,3,0,0" TextWrapping="Wrap" TextAlignment="Right"/>

                            <Border Margin="5,7,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <DatePicker x:Name="DPDate" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- CountCinema -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Кол-во кинотеатров" Width="87" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right" Margin="0,3,0,0"/>

                            <Border Margin="5,0,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <TextBox x:Name="TbCountCinema" MaxLength="9" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Fees -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Сборы" FontSize="14" FontWeight="Bold" Margin="35,5,0,0"/>

                            <Border Margin="5,0,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <TextBox x:Name="TbFees" BorderThickness="0" MaxLength="9" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Rating -->
                        <TextBlock Text="Рейтинг" FontSize="14" FontWeight="Bold" Margin="5,5,0,0"/>

                        <StackPanel x:Name="StackRating" Orientation="Horizontal" Margin="15,0,0,0">
                            <StackPanel.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="LightGray"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Rectangle x:Name="box" Width="10" Height="10" Fill="{TemplateBinding Foreground}"/>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="box" Property="Fill" Value="OrangeRed"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <Button Tag="1" Click="Rating_Click" />
                            <Button Tag="2" Click="Rating_Click" />
                            <Button Tag="3" Click="Rating_Click" />
                            <Button Tag="4" Click="Rating_Click" />
                            <Button Tag="5" Click="Rating_Click" />
                            <Button Tag="6" Click="Rating_Click" />
                            <Button Tag="7" Click="Rating_Click" />
                            <Button Tag="8" Click="Rating_Click" />
                            <Button Tag="9" Click="Rating_Click" />
                            <Button Tag="10" Click="Rating_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10">
                        <Button x:Name="BtnAddEdit" Content="Добавить/Изменить" Style="{StaticResource StButtonMain}" Click="BtnAddEdit_Click" Margin="0,0,0,10"/>
                        <Button x:Name="BtnClearForm" Content="Очистить" Style="{StaticResource StButtonMain}" Click="BtnClearForm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
