<UserControl x:Class="CinemaStudio.UserProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CinemaStudio"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="StButtonMain" TargetType="Button">
            <Setter Property="Background" Value="#991F44A9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
           Background="{TemplateBinding Background}" 
           BorderThickness="2"
           BorderBrush="#FFFFFF"
           CornerRadius="10"
           Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="#FF1F44A9"/>
                    <Setter Property="BorderBrush" Value="#FF4E85EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF5646A8"/>
                    <Setter Property="BorderBrush" Value="#FF5646A8"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#401F44A9"/>
                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StTextListEmpty" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=DGProject, Path=Items.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StDGColumn" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Проекты" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="30"/>

            <Grid Grid.Row="1" MaxWidth="1150" MaxHeight="700">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,10,20,0">
                        <Border Background="#99FFFFFF" BorderThickness="0,0,0,2" BorderBrush="#898989" CornerRadius="20,20,0,0"/>
                        <WrapPanel>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,5,0,3">
                                <TextBlock Text="Фильтр по статусу" FontSize="18" FontWeight="Bold"/>
                                <ComboBox x:Name="CbStatusFilter" DisplayMemberPath="Name" Width="150" FontSize="14" IsEditable="False" Margin="7,0" SelectionChanged="CbStatusFilter_SelectionChanged"/>
                            </StackPanel>

                            <Button x:Name="BtnClearFilter" Grid.Column="1" Content="Очистить фильтр" Style="{StaticResource StButtonMain}" Margin="10,2" Click="BtnClearFilter_Click"/>
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,0,20,20">
                        <Border Background="#99FFFFFF" BorderThickness="0,0,0,2" CornerRadius="0,0,20,20">
                            <Grid>
                                <DataGrid 
                                  x:Name="DGProject"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  Background="Transparent" 
                                  BorderThickness="0"                                          
                                  Margin="7"
                                  SelectionChanged="DGProject_SelectionChanged">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Название" TextTrimming="CharacterEllipsis" ToolTip="Название"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding GenreStr}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Жанр(ы)" TextTrimming="CharacterEllipsis" ToolTip="Жанр(ы)"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Budget}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Бюджет" TextTrimming="CharacterEllipsis" ToolTip="Бюджет"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding DateStart, StringFormat={}{0:dd.MM.yyyy}}" Width="1.3*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Дата начала" TextTrimming="CharacterEllipsis" ToolTip="Дата начала"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding DateEnd, StringFormat={}{0:dd.MM.yyyy}}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Дата окончания" TextTrimming="CharacterEllipsis" ToolTip="Дата окончания"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Status.Name}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Статус" TextTrimming="CharacterEllipsis" ToolTip="Бюджет"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding TargetAudience}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Целевая аудитория" TextTrimming="CharacterEllipsis" ToolTip="Целевая аудитория"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Ничего не найдено" FontSize="22" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StTextListEmpty}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Border Background="#99FFFFFF" CornerRadius="20,0,0,20" Width="210">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Форма" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" Margin="3,3,0,0">
                        <!-- Name -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Название" FontSize="14" FontWeight="Bold" Margin="6,3,0,0"/>

                            <Border Margin="5,0,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <TextBox x:Name="TbName" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Genre -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Жанр" FontSize="14" FontWeight="Bold" Margin="34,3,0,0"/>

                            <Border Margin="5,0,0,0" Padding="2.5" Width="120" Height="32" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <ComboBox x:Name="CbGenre" Text="Выберите" BorderThickness="0" Background="Transparent" FontSize="14" IsEditable="True" IsReadOnly="True">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox 
                                      Content="{Binding Name}"
                                      Focusable="False"
                                      Margin="2"
                                      Click="CheckBoxGenre_Click" Loaded="CheckBoxGenre_Loaded"/>

                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Date start -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Дата начала" Width="60" FontSize="14" FontWeight="Bold" Margin="14,3,0,0" TextWrapping="Wrap" TextAlignment="Right"/>

                            <Border Margin="5,5,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <DatePicker x:Name="DPDateStart" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Date end -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Дата окончания" Width="75" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Right"/>

                            <Border Margin="5,5,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <DatePicker x:Name="DPDateEnd" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Статус" FontSize="14" FontWeight="Bold" Margin="32,3,0,0"/>

                            <Border Margin="5,0,0,0" Padding="3" Width="120" Height="32" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <ComboBox x:Name="CbFormStatus" DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Budget -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Бюджет" FontSize="14" FontWeight="Bold" Margin="20,5,0,0"/>

                            <Border Margin="5,0,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <TextBox x:Name="TbBudget" MaxLength="9" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="OnlyRealNumber_TextChanged"/>
                            </Border>
                        </StackPanel>

                        <!-- Target audience -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Целевая аудитория" Width="77" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right" Margin="0,5,0,0"/>

                            <Border Margin="5,10,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <TextBox x:Name="TbTargetAudience" MaxLength="250" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10">
                        <Button x:Name="BtnAddEdit" Content="Добавить/Изменить" Style="{StaticResource StButtonMain}" Click="BtnAddEdit_Click" Margin="0,0,0,10"/>
                        <Button x:Name="BtnClearForm" Content="Очистить" Style="{StaticResource StButtonMain}" Click="BtnClearForm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
