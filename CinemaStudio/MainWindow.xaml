<Window x:Class="CinemaStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaStudio"
        mc:Ignorable="d"
       Title="Авторизация" MinHeight="370" MinWidth="400" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="StButtonMain" TargetType="Button">
            <Setter Property="Background" Value="#991F44A9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                    Background="{TemplateBinding Background}" 
                    BorderThickness="2"
                    BorderBrush="#FFFFFF"
                    CornerRadius="10"
                    Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="#FF1F44A9"/>
                    <Setter Property="BorderBrush" Value="#FF4E85EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF5646A8"/>
                    <Setter Property="BorderBrush" Value="#FF5646A8"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#401F44A9"/>
                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StBtnSecond" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2579D8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                    Background="{TemplateBinding Background}"
                    BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="#FF4E85EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#FF1F44A9"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#552579D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.9, 0.9" EndPoint="0.1, 0.1">
                    <GradientStop Color="#CC211E68" Offset="0.1171"/>
                    <GradientStop Color="#CC5646A8" Offset="0.3837"/>
                    <GradientStop Color="#CC1F44A9" Offset="0.6504"/>
                    <GradientStop Color="#CC4E85EB" Offset="0.8789"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Width="300" Height="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="20" Grid.RowSpan="3">
                <Border.Background>
                    <SolidColorBrush Color="#99FFFFFF"/>
                </Border.Background>
            </Border>

            <TextBlock Grid.Row="0" Text="АВТОРИЗАЦИЯ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="30"/>

            <StackPanel Grid.Row="1" Margin="20">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="Логин" FontSize="16" FontWeight="Bold"/>

                    <Border Margin="10,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <TextBox x:Name="TbLogin" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Пароль" FontSize="16" FontWeight="Bold"/>

                    <Border Margin="10,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <PasswordBox x:Name="PbPassword" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Button x:Name="BtnLogIn" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,25" Width="130" Height="40" Content="Войти" Style="{StaticResource StButtonMain}" Click="BtnLogIn_Click"/>
        </Grid>
    </Grid>
</Window>
