<UserControl x:Class="CinemaStudio.UserShootingSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CinemaStudio"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="StButtonMain" TargetType="Button">
            <Setter Property="Background" Value="#991F44A9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
      Background="{TemplateBinding Background}" 
      BorderThickness="2"
      BorderBrush="#FFFFFF"
      CornerRadius="10"
      Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="#FF1F44A9"/>
                    <Setter Property="BorderBrush" Value="#FF4E85EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF5646A8"/>
                    <Setter Property="BorderBrush" Value="#FF5646A8"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#401F44A9"/>
                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StTextListEmpty" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=DGShootingSchedule, Path=Items.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StDGColumn" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="График съемок" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="30"/>

            <Grid Grid.Row="1" MaxWidth="1150" MaxHeight="700">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,10,20,0">
                        <Border Background="#99FFFFFF" BorderThickness="0,0,0,2" BorderBrush="#898989" CornerRadius="20,20,0,0">
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,5,0,3">
                                    <TextBlock Text="Фильтр по дате" FontSize="18" FontWeight="Bold"/>
                                    <Border Margin="5,0,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                        <DatePicker x:Name="DPDateFilter" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" SelectedDateChanged="DPDateFilter_SelectedDateChanged"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="10,5,0,3">
                                    <TextBlock Text="Фильтр по проекту" FontSize="18" FontWeight="Bold"/>
                                    <ComboBox x:Name="CbProjectFilter" DisplayMemberPath="Name" Width="150" FontSize="14" IsEditable="False" Margin="7,0" SelectionChanged="CbProjectFilter_SelectionChanged" Loaded="CbProject_Loaded"/>
                                </StackPanel>

                                <Button x:Name="BtnClearFilter" Content="Очистить фильтры" Style="{StaticResource StButtonMain}" Click="BtnClearFilter_Click"/>
                            </WrapPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,0,20,20">
                        <Border Background="#99FFFFFF" BorderThickness="0,0,0,2" CornerRadius="0,0,20,20">
                            <Grid>
                                <DataGrid 
                                 x:Name="DGShootingSchedule"
                                 AutoGenerateColumns="False"
                                 HeadersVisibility="Column"
                                 IsReadOnly="True"
                                 Background="Transparent" 
                                 BorderThickness="0"                                          
                                 Margin="7"
                                 SelectionChanged="DGShootingSchedule_SelectionChanged">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Project.Name}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Проект" TextTrimming="CharacterEllipsis" ToolTip="Проект"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Дата" TextTrimming="CharacterEllipsis" ToolTip="Дата"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Time}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Время" TextTrimming="CharacterEllipsis" ToolTip="Время"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Area.Address}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Площадка" TextTrimming="CharacterEllipsis" ToolTip="Площадка"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Scene}" Width="*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Сцена" TextTrimming="CharacterEllipsis" ToolTip="Сцена"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Description}" Width="1.2*" HeaderStyle="{StaticResource StDGColumn}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Описание" TextTrimming="CharacterEllipsis" ToolTip="Описание"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Ничего не найдено" FontSize="22" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StTextListEmpty}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Border Background="#99FFFFFF" CornerRadius="20,0,0,20" Width="210">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Форма" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" Margin="3,3,0,0">
                        <!-- Project -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Проект" FontSize="14" FontWeight="Bold" Margin="27,3,0,0"/>

                            <Border Margin="5,0,0,0" Padding="3" Width="120" Height="32" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <ComboBox x:Name="CbFormProject" DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" Loaded="CbProject_Loaded"/>
                            </Border>
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Дата" FontSize="14" FontWeight="Bold" Margin="44,3,0,0" TextWrapping="Wrap" TextAlignment="Right"/>

                            <Border Margin="5,0,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <DatePicker x:Name="DPDate" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Time -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Время" FontSize="14" FontWeight="Bold" Margin="30,5,0,0"/>

                            <StackPanel Orientation="Horizontal">
                                <Border Margin="5,0,0,0" Padding="3" Width="55" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                    <ComboBox x:Name="CbHours" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" Loaded="CbHours_Loaded"/>
                                </Border>
                                <TextBlock Text=":" FontSize="14" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                                <Border Padding="3" Width="55" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                    <ComboBox x:Name="CbMinutes" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" Loaded="CbMinutes_Loaded"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                        <!-- Area -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Площадка" FontSize="14" FontWeight="Bold" Margin="5,3,0,0"/>

                            <Border Margin="5,0,0,0" Padding="3" Width="120" Height="32" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <ComboBox x:Name="CbArea" DisplayMemberPath="Address" SelectedValuePath="Address" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" Loaded="CbArea_Loaded"/>
                            </Border>
                        </StackPanel>

                        <!-- Scene -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Сцена" FontSize="14" FontWeight="Bold" Margin="35,5,0,0"/>

                            <Border Margin="5,0,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <TextBox x:Name="TbScene" MaxLength="250" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Text="Описание" FontSize="14" FontWeight="Bold" Margin="5,5,0,0"/>

                        <Border Margin="5,0" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                            <TextBox x:Name="TbDescription" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10">
                        <Button x:Name="BtnAddEdit" Content="Добавить/Изменить" Style="{StaticResource StButtonMain}" Click="BtnAddEdit_Click" Margin="0,0,0,10"/>
                        <Button x:Name="BtnClearForm" Content="Очистить" Style="{StaticResource StButtonMain}" Click="BtnClearForm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
