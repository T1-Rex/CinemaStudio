<UserControl x:Class="CinemaStudio.UserFilmingGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CinemaStudio"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="StButtonMain" TargetType="Button">
            <Setter Property="Background" Value="#991F44A9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                    Background="{TemplateBinding Background}" 
                    BorderThickness="2"
                    BorderBrush="#FFFFFF"
                    CornerRadius="10"
                    Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="#FF1F44A9"/>
                    <Setter Property="BorderBrush" Value="#FF4E85EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF5646A8"/>
                    <Setter Property="BorderBrush" Value="#FF5646A8"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#401F44A9"/>
                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StTextListEmpty" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=ListFilmGroup, Path=Items.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StDGColumn" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Съемочная группа" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="35"/>

            <Grid Grid.Row="1" MaxWidth="1150" MaxHeight="700">
                <Border Background="#99FFFFFF" BorderThickness="0,0,0,2" CornerRadius="20" Margin="20">
                    <Grid>
                        <ItemsControl x:Name="ListFilmGroup" Background="Transparent" BorderThickness="0" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Key}" FontWeight="Bold" FontSize="16"/>

                                        <ListView ItemsSource="{Binding}" SelectionMode="Single" Background="Transparent" BorderThickness="0" SelectionChanged="ListFilmGroup_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Employee.FullName}" FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text=" - " FontSize="14"/>
                                                        <TextBlock Text="{Binding RoleInProject}" FontSize="14" FontStyle="Italic"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Ничего не найдено" FontSize="22" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StTextListEmpty}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Border Background="#99FFFFFF" CornerRadius="20,0,0,20" Width="220">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Форма" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" Margin="3,3,0,0">
                        <!-- Project -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Проект" FontSize="14" FontWeight="Bold" Margin="38,3,0,0"/>

                            <Border Margin="5,0,0,0" Padding="3" Width="120" Height="32" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <ComboBox x:Name="CbProject" DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" Loaded="CbProject_Loaded"/>
                            </Border>
                        </StackPanel>

                        <!-- Employee -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Сотрудник" FontSize="14" FontWeight="Bold" Margin="15,3,0,0"/>

                            <Border Margin="5,0,0,0" Padding="3" Width="120" Height="32" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <ComboBox x:Name="CbEmployee" DisplayMemberPath="FullName" SelectedValuePath="FullName" IsEditable="False" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" Loaded="CbEmployee_Loaded"/>
                            </Border>
                        </StackPanel>

                        <!-- RoleInProject -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Роль в проекте" Width="60" FontSize="14" FontWeight="Bold" Margin="30,5,0,0" TextWrapping="Wrap" TextAlignment="Right"/>

                            <Border Margin="5,7,0,0" Width="120" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                                <TextBox x:Name="TbRoleInProject" MaxLength="250" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10">
                        <Button x:Name="BtnAddEdit" Content="Добавить/Изменить" Style="{StaticResource StButtonMain}" Click="BtnAddEdit_Click" Margin="0,0,0,10"/>
                        <Button x:Name="BtnClearForm" Content="Очистить" Style="{StaticResource StButtonMain}" Click="BtnClearForm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
