<Window x:Class="CinemaStudio.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaStudio"
        mc:Ignorable="d"
       Title="Сотрудник" Height="690" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="StButtonMain" TargetType="Button">
            <Setter Property="Background" Value="#991F44A9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
             Background="{TemplateBinding Background}" 
             BorderThickness="2"
             BorderBrush="#FFFFFF"
             CornerRadius="10"
             Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="#FF1F44A9"/>
                    <Setter Property="BorderBrush" Value="#FF4E85EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF5646A8"/>
                    <Setter Property="BorderBrush" Value="#FF5646A8"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#401F44A9"/>
                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль прогрессбара и изменение его -->
        <Style x:Key="PbPwd" TargetType="ProgressBar">
            <Style.Triggers>
                <Trigger Property="Value" Value="1">
                    <Setter Property="Foreground" Value="Red"/>
                </Trigger>

                <Trigger Property="Value" Value="2">
                    <Setter Property="Foreground" Value="Orange"/>
                </Trigger>

                <Trigger Property="Value" Value="3">
                    <Setter Property="Foreground" Value="Yellow"/>
                </Trigger>

                <Trigger Property="Value" Value="4">
                    <Setter Property="Foreground" Value="Green"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StNotRequiredField" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=TbPatronymic}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.9, 0.9" EndPoint="0.1, 0.1">
                    <GradientStop Color="#CC211E68" Offset="0.1171"/>
                    <GradientStop Color="#CC5646A8" Offset="0.3837"/>
                    <GradientStop Color="#CC1F44A9" Offset="0.6504"/>
                    <GradientStop Color="#CC4E85EB" Offset="0.8789"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="GridMain" Width="300" Height="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="20" Grid.RowSpan="3">
                <Border.Background>
                    <SolidColorBrush Color="#99FFFFFF"/>
                </Border.Background>
            </Border>

            <TextBlock x:Name="TextTitle" Grid.Row="0" Text="РЕГИСТРАЦИЯ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15"/>

            <StackPanel Grid.Row="1">
                <!-- Surname -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="Фамилия" FontSize="16" FontWeight="Bold" Margin="13,0,0,0"/>

                    <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <TextBox x:Name="TbSurname" MaxLength="100" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="LettersWrite_TextChanged"/>
                    </Border>
                </StackPanel>

                <!-- Name -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Text="Имя" FontSize="16" FontWeight="Bold" Margin="53,0,0,0"/>

                    <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <TextBox x:Name="TbName" MaxLength="100" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="LettersWrite_TextChanged"/>
                    </Border>
                </StackPanel>

                <!-- Patronymic -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Text="Отчество" FontSize="16" FontWeight="Bold" Margin="15,0,0,0"/>

                    <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <Grid>
                            <TextBox x:Name="TbPatronymic" MaxLength="100" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="LettersWrite_TextChanged"/>
                            <TextBlock Text="Не обязательное поле" Foreground="Gray" FontSize="14" FontWeight="Bold" Padding="7,2" IsHitTestVisible="False" Style="{StaticResource StNotRequiredField}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Specialization -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Width="85" Text="Специализация" FontSize="16" FontWeight="Bold" Margin="0,0,0,0" TextWrapping="Wrap" TextAlignment="Right"/>

                    <ComboBox x:Name="CbSpecialization" DisplayMemberPath="Name" SelectedValuePath="Name" FontSize="14" Padding="5,2" Width="180" Height="30" VerticalAlignment="Top" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989" Margin="5,5,0,0"/>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Text="Телефон" FontSize="16" FontWeight="Bold" Margin="18,0,0,0"/>

                    <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <TextBox x:Name="TbPhone" MaxLength="12" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="TbPhone_TextChanged"/>
                    </Border>
                </StackPanel>

                <!-- Email -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Text="Email" FontSize="16" FontWeight="Bold" Margin="45,0,0,0"/>

                    <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <TextBox x:Name="TbEmail" MaxLength="120" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="TbEmail_TextChanged"/>
                    </Border>
                </StackPanel>

                <!-- Ставка -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Text="Ставка" FontSize="16" FontWeight="Bold" Margin="35,0,0,0"/>

                    <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <TextBox x:Name="TbBet" MaxLength="10" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="TbBet_TextChanged"/>
                    </Border>
                </StackPanel>

                <!-- Фото -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Text="Фото" FontSize="16" FontWeight="Bold" Margin="35,0,0,0"/>

                    <Button x:Name="BtnPhoto" Grid.Row="2" Content="Добавить фото" Style="{StaticResource StButtonMain}" Margin="10,0,0,0" Click="BtnPhoto_Click"/>
                </StackPanel>

                <!-- Login -->
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <TextBlock Text="Логин" FontSize="16" FontWeight="Bold" Margin="37,0,0,0"/>

                    <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                        <TextBox x:Name="TbLogin" MaxLength="50" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" TextChanged="TbLogin_TextChanged"/>
                    </Border>
                </StackPanel>

                <!-- При добавлении -->
                <StackPanel  x:Name="StAddPwd" Visibility="Visible">
                    <!-- Password -->
                    <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                        <TextBlock Text="Пароль" FontSize="16" FontWeight="Bold" Margin="27,0,0,0"/>

                        <Border Margin="5,0,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                            <PasswordBox x:Name="PbPasswordText" MaxLength="64" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" PasswordChanged="PbPasswordText_PasswordChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Уровень защиты пароля -->
                    <StackPanel x:Name="StackPanelLvlPwd" Orientation="Horizontal" Margin="0,7,40,0" HorizontalAlignment="Right" Visibility="Collapsed">
                        <ProgressBar x:Name="PbPassword" Width="100" Height="10" Minimum="0" Maximum="4" Value="0" Style="{StaticResource PbPwd}"/>
                        <TextBlock x:Name="TbTextStatusPwd" Text="" Margin="5,0,0,0" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Repeat password -->
                    <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                        <TextBlock Width="130" Text="Подтверждение пароля" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" TextAlignment="Right"/>

                        <Border Margin="5,0,0,0" Width="135" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                            <PasswordBox x:Name="PbReapetPassword" MaxLength="64" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- При редактировании -->
                <StackPanel x:Name="StEditPwd" Visibility="Collapsed">
                    <!-- Old Password -->
                    <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                        <TextBlock Text="Старый пароль" Width="70" TextAlignment="Right" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" Margin="16,0,0,0"/>

                        <Border Margin="5,5,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                            <PasswordBox x:Name="PbPasswordTextOld" MaxLength="64" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                        </Border>
                    </StackPanel>

                    <!-- New Password -->
                    <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                        <TextBlock Text="Новый пароль" Width="70" TextAlignment="Right" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" Margin="17,0,0,0"/>

                        <Border Margin="5,5,0,0" Width="180" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                            <PasswordBox x:Name="PbNewPasswordText" MaxLength="64" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2" PasswordChanged="PbNewPasswordText_PasswordChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Уровень защиты пароля -->
                    <StackPanel x:Name="StackPanelLvlPwdNew" Orientation="Horizontal" Margin="0,7,40,0" HorizontalAlignment="Right" Visibility="Collapsed">
                        <ProgressBar x:Name="PbPasswordNew" Width="100" Height="10" Minimum="0" Maximum="4" Value="0" Style="{StaticResource PbPwd}"/>
                        <TextBlock x:Name="TbTextStatusPwdNew" Text="" Margin="5,0,0,0" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Repeat password -->
                    <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                        <TextBlock Width="130" Text="Подтверждение пароля" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" TextAlignment="Right"/>

                        <Border Margin="5,0,0,0" Width="135" Height="30" VerticalAlignment="Top" CornerRadius="10" Background="#CCF9F9F9" BorderThickness="2" BorderBrush="#898989">
                            <PasswordBox x:Name="PbReapetPasswordNew" MaxLength="64" BorderThickness="0" Background="Transparent" FontSize="14" Padding="5,2"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Button x:Name="BtnLogIn" Grid.Row="2" Width="200" Height="40" Content="Зарегистрироваться" Style="{StaticResource StButtonMain}" Margin="0,0,0,10" Click="BtnLogIn_Click"/>
        </Grid>

        <Button x:Name="BtnBack" Width="60" Height="40" Style="{StaticResource StButtonMain}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" Click="BtnBack_Click">
            <Button.Content>
                <Image Source="/Images/BackImg.png" Stretch="UniformToFill" Width="20" Height="20"/>
            </Button.Content>
        </Button>
    </Grid>
</Window>
